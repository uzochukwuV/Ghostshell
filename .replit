modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CODEX_MODEL = "z-ai/glm-5.2:free"
TOKEN_ROUTER_BASE_URL = "https://api.tokenrouter.com/v1"
CODEX_BASE_URL = "https://openrouter.ai/api/v1/"
