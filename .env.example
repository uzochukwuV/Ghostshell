# Required to create and reattach the Daytona coding sandbox.
DAYTONA_API_KEY=

# Generic, OpenAI-compatible model-provider configuration. Keep this file free of values.
# For Nebius, obtain the endpoint URL, supported model ID, and API key from its console.
CODEX_PROVIDER=nebius
CODEX_PROVIDER_NAME=Nebius
CODEX_BASE_URL=
CODEX_MODEL=
CODEX_API_KEY=

# Legacy OpenRouter compatibility (omit when CODEX_API_KEY is set).
# OPENROUTER_KEY=
# TOKEN_ROUTER_API_KEY=

# Keep unset unless Docker inside the Daytona sandbox is explicitly required.
# ENABLE_DOCKER=true
